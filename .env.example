# DagsHub token — copy to .env and fill in (never commit .env)
# Get yours at: https://dagshub.com/user/settings/tokens
DAGSHUB_USER_TOKEN=your_dagshub_personal_access_token

# Kaggle credentials (needed for dataset download)
# Get yours at: https://www.kaggle.com/settings → API → Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
