# DagsHub credentials — copy to .env and fill in (never commit .env)
DAGSHUB_USERNAME=your_dagshub_username
DAGSHUB_TOKEN=your_dagshub_personal_access_token

# MLflow tracking (set to your DagsHub MLflow URL)
MLFLOW_TRACKING_URI=https://dagshub.com/<DAGSHUB_USERNAME>/ai-image-detector.mlflow
MLFLOW_TRACKING_USERNAME=your_dagshub_username
MLFLOW_TRACKING_PASSWORD=your_dagshub_personal_access_token

# Kaggle credentials (needed for dataset download)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
